<%
  const classNames = { SL: 'Sleeper', '3A': 'AC 3 tier' };
  const money = (v) => 'Rs ' + Number(v).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
%>
<%- include('partials/top', { title: 'Check a fare', current: 'fare' }) %>
  <div class="page-head">
    <h1>Check a fare</h1>
    <p>See the full fare before you book: base fare, reservation charge, GST and the booking fee.</p>
  </div>

  <%- include('partials/error', { error }) %>

  <form class="panel" method="get" action="/fare" novalidate>
    <div class="grid-2">
      <div class="field">
        <label for="train" id="train-label">Train</label>
        <select id="train" name="train" data-combobox>
          <% trains.forEach(function (t) { %>
            <option value="<%= t.number %>" <%= q.train === t.number ? 'selected' : '' %>><%= t.name %> (<%= t.number %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="passengers">Passengers</label>
        <input id="passengers" type="number" name="passengers" value="<%= q.passengers %>" min="1" max="6" inputmode="numeric" aria-describedby="passengers-hint">
        <p class="hint" id="passengers-hint">1 to 6.</p>
      </div>
    </div>
    <div class="route-pair" style="margin-top: 1rem">
      <div class="field">
        <label for="from" id="from-label">From</label>
        <select id="from" name="from" data-combobox>
          <% stations.forEach(function (s) { %>
            <option value="<%= s.code %>" <%= (q.from || 'SBC').toUpperCase() === s.code ? 'selected' : '' %>><%= s.name %> (<%= s.code %>)</option>
          <% }) %>
        </select>
      </div>
      <button class="swap" type="button" data-swap hidden title="Swap From and To">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
          <path d="M2.5 6h12m0 0-3-3m3 3-3 3M15.5 12h-12m0 0 3-3m-3 3 3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="vh">Swap From and To stations</span>
      </button>
      <div class="field">
        <label for="to" id="to-label">To</label>
        <select id="to" name="to" data-combobox>
          <% stations.forEach(function (s) { %>
            <option value="<%= s.code %>" <%= (q.to || 'MAS').toUpperCase() === s.code ? 'selected' : '' %>><%= s.name %> (<%= s.code %>)</option>
          <% }) %>
        </select>
      </div>
    </div>
    <fieldset style="margin-top: 1rem">
      <legend>Class</legend>
      <div class="choices">
        <% ['SL', '3A'].forEach(function (c) { %>
          <label class="choice">
            <input type="radio" name="class" value="<%= c %>" <%= q.classCode === c ? 'checked' : '' %>>
            <span><%= classNames[c] %><small translate="no"><%= c %></small></span>
          </label>
        <% }) %>
      </div>
    </fieldset>
    <div class="form-actions">
      <button class="button button--primary" type="submit" data-busy-text="Working out fare…">Get fare</button>
    </div>
  </form>

  <% if (quote) { %>
    <section class="panel" aria-labelledby="fare-heading">
      <h2 id="fare-heading" class="section-head">Fare for <span translate="no"><%= quote.train %></span>, <%= String(quote.from).toUpperCase() %> to <%= String(quote.to).toUpperCase() %></h2>
      <div class="table-wrap">
        <table>
          <caption><%= classNames[quote.classCode] || quote.classCode %>, <%= quote.passengers %> <%= quote.passengers === 1 ? 'passenger' : 'passengers' %>, <%= quote.distanceKm %> km<%= quote.chargeableKm > quote.distanceKm ? ' (charged as ' + quote.chargeableKm + ' km, the class minimum)' : '' %></caption>
          <thead>
            <tr><th scope="col">Item</th><th scope="col" class="num">Amount</th></tr>
          </thead>
          <tbody>
            <% quote.breakup.forEach(function (line) { %>
              <tr><th scope="row"><%= line.item %></th><td class="num"><%= money(line.amount) %></td></tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr><th scope="row">Total</th><td class="num"><%= money(quote.totalRupees) %></td></tr>
          </tfoot>
        </table>
      </div>
    </section>
  <% } %>
<%- include('partials/bottom') %>

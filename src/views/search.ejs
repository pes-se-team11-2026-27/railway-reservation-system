<%
  const pad = (n) => String(n).padStart(2, '0');
  const iso = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  const now = new Date();
  const today = iso(now);
  const tomorrow = iso(new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1));
  // Runs are loaded 30 days ahead (today plus 29), so the picker stops there.
  const lastDay = iso(new Date(now.getFullYear(), now.getMonth(), now.getDate() + 29));
  const shiftDay = (d, n) => { const [y, m, dd] = d.split('-').map(Number); return iso(new Date(y, m - 1, dd + n)); };
  const longDate = (d) => new Intl.DateTimeFormat('en-IN', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' })
    .format(new Date(d + 'T00:00:00Z'));
  const mins = (t) => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
  const duration = (t) => {
    const d = mins(t.arrives) + t.arrivalDay * 1440 - mins(t.departs);
    return `${Math.floor(d / 60)} h ${pad(d % 60)} m`;
  };
  const nameOf = (code) => (stations.find((s) => s.code === code) || { name: code }).name;
  const from = query.from || 'SBC';
  const to = query.to || 'MAS';
  const date = query.date || tomorrow;
  const classNames = { SL: 'Sleeper', '3A': 'AC 3 tier' };
  const classOrder = { SL: 1, '3A': 2 };
%>
<%- include('partials/top', { title: 'Search trains', current: 'search' }) %>
  <div class="page-head">
    <h1>Find a train</h1>
    <p>Pick your stations and journey date to see trains, times and the berths left in each class.</p>
  </div>

  <%- include('partials/error', { error }) %>

  <form class="panel search-form" method="get" action="/search" role="search" aria-label="Search trains">
    <div class="route-pair">
      <div class="field">
        <label for="from" id="from-label">From</label>
        <select id="from" name="from" autocomplete="off" data-combobox>
          <% stations.forEach(function (s) { %>
            <option value="<%= s.code %>" <%= from === s.code ? 'selected' : '' %>><%= s.name %> (<%= s.code %>)</option>
          <% }) %>
        </select>
      </div>
      <button class="swap" type="button" data-swap hidden title="Swap From and To">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false">
          <path d="M2.5 6h12m0 0-3-3m3 3-3 3M15.5 12h-12m0 0 3-3m-3 3 3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="vh">Swap From and To stations</span>
      </button>
      <div class="field">
        <label for="to" id="to-label">To</label>
        <select id="to" name="to" autocomplete="off" data-combobox>
          <% stations.forEach(function (s) { %>
            <option value="<%= s.code %>" <%= to === s.code ? 'selected' : '' %>><%= s.name %> (<%= s.code %>)</option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="field">
      <label for="date" id="date-label">Journey date</label>
      <input id="date" type="date" name="date" value="<%= date %>" min="<%= today %>" max="<%= lastDay %>" required data-datepicker>
    </div>
    <button class="button button--primary" type="submit" data-busy-text="Searching…">Search trains</button>
  </form>
  <div class="recent" data-recent hidden></div>

  <% if (trains) { %>
    <section class="panel" aria-labelledby="results-heading">
      <div class="section-head">
        <h2 id="results-heading">
          <%= trains.length === 1 ? '1 train' : trains.length + ' trains' %> from <%= nameOf(query.from) %> to <%= nameOf(query.to) %>
        </h2>
        <p><%= longDate(query.date) %>. Availability is for the general quota and updates live.</p>
        <nav class="day-nav" aria-label="Change journey date">
          <% if (query.date > today) { %>
            <a href="/search?from=<%= query.from %>&to=<%= query.to %>&date=<%= shiftDay(query.date, -1) %>" rel="prev">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false"><path d="M8.5 3 4.5 7l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <%= longDate(shiftDay(query.date, -1)) %>
            </a>
          <% } %>
          <% if (query.date < lastDay) { %>
            <a href="/search?from=<%= query.from %>&to=<%= query.to %>&date=<%= shiftDay(query.date, 1) %>" rel="next">
              <%= longDate(shiftDay(query.date, 1)) %>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false"><path d="m5.5 3 4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          <% } %>
        </nav>
      </div>

      <% if (!trains.length) { %>
        <div class="empty">
          <p>No trains run between these stations on <%= longDate(query.date) %>. Trains only run in the direction of their route, and the Chennai Mail runs Monday to Friday.</p>
          <p>
            <a href="/search?from=<%= query.from %>&to=<%= query.to %>&date=<%= shiftDay(query.date, -1) %>">Try the day before</a>
            or
            <a href="/search?from=<%= query.from %>&to=<%= query.to %>&date=<%= shiftDay(query.date, 1) %>">the day after</a>.
          </p>
        </div>
      <% } else { %>
        <ol class="journeys">
          <% trains.forEach(function (t) { %>
            <li class="journey">
              <div>
                <span class="train-no" translate="no"><%= t.number %></span>
                <span class="train-name"><%= t.name %></span>
              </div>

              <div class="times">
                <p class="vh">Departs <%= t.departs %> from <%= nameOf(query.from) %>, arrives <%= t.arrives %><%= t.arrivalDay ? ' the next day' : '' %> at <%= nameOf(query.to) %>. Journey time <%= duration(t) %>, <%= t.distanceKm %> km.</p>
                <div class="stop" aria-hidden="true">
                  <time><%= t.departs %></time>
                  <span translate="no"><%= query.from %></span>
                </div>
                <div aria-hidden="true">
                  <div class="route-line"></div>
                  <span class="route-meta"><%= duration(t) %>, <%= t.distanceKm %> km</span>
                </div>
                <div class="stop" aria-hidden="true">
                  <time><%= t.arrives %><% if (t.arrivalDay) { %><span class="next-day">+1</span><% } %></time>
                  <span translate="no"><%= query.to %></span>
                </div>
              </div>

              <ul class="availability" aria-label="Book on <%= t.number %>">
                <% t.classes.slice().sort(function (a, b) { return (classOrder[a] || 9) - (classOrder[b] || 9); }).forEach(function (c) {
                     const a = t.availability[c];
                     const kind = a.confirmedAvailable > 0 ? 'cnf' : (a.racAvailable > 0 ? 'rac' : 'wl');
                     const label = a.confirmedAvailable > 0 ? a.confirmedAvailable + ' available'
                       : (a.racAvailable > 0 ? 'RAC ' + a.racAvailable : 'WL ' + (a.waitlist + 1)); %>
                  <li>
                    <a class="chip chip--<%= kind %>" href="/book?runId=<%= t.runId %>&class=<%= c %>"><%= c %>: <%= label %><span class="vh">, book <%= classNames[c] || c %></span></a>
                  </li>
                <% }) %>
              </ul>
            </li>
          <% }) %>
        </ol>
      <% } %>
    </section>
  <% } else { %>
    <section class="panel empty" aria-labelledby="routes-heading">
      <h2 id="routes-heading" class="section-head">Routes in this build</h2>
      <p>Three trains run from KSR Bengaluru to Chennai Central, stopping at Bangarapet and Katpadi. Bookings open 30 days ahead. Tatkal opens at 10:00 on the day before travel.</p>
    </section>
  <% } %>
<%- include('partials/bottom') %>

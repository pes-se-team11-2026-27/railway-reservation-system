<%
  const errorField = locals.errorField || null;
  // Marks the field invalid and points it at its hint and its error message.
  const invalid = (f, hint) => {
    const ids = [hint, errorField === f ? f + '-error' : null].filter(Boolean).join(' ');
    return (errorField === f ? 'aria-invalid="true" ' : '') + (ids ? 'aria-describedby="' + ids + '"' : '');
  };
  const fieldError = (f) => errorField === f ? '<p class="field-error" id="' + f + '-error">' + String(error).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;') + '</p>' : '';
%>
<%- include('partials/top', { title: !account ? 'Create an account' : (account.mobileVerified ? 'Account verified' : 'Verify your mobile number'), current: 'register' }) %>

<% if (!account) { %>
  <div class="page-head">
    <h1>Create an account</h1>
    <p>Your mobile number is your account. We send a code to it once to confirm it is yours.</p>
  </div>

  <%- include('partials/error', { error, errorField }) %>

  <form class="panel narrow" method="post" action="/register" novalidate>
    <div class="field">
      <label for="name">Full name</label>
      <input id="name" type="text" name="name" value="<%= values.name || '' %>" autocomplete="name" required <%- invalid('name') %>>
      <%- fieldError('name') %>
    </div>
    <div class="field">
      <label for="mobile">Mobile number</label>
      <input id="mobile" type="tel" name="mobile" value="<%= values.mobile || '' %>" autocomplete="tel-national"
             inputmode="numeric" maxlength="10" required <%- invalid('mobile', 'mobile-hint') %>>
      <p class="hint" id="mobile-hint">10 digits, starting with 6, 7, 8 or 9.</p>
      <%- fieldError('mobile') %>
    </div>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" type="email" name="email" value="<%= values.email || '' %>" autocomplete="email"
             spellcheck="false" required <%- invalid('email') %>>
      <%- fieldError('email') %>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input id="password" type="password" name="password" autocomplete="new-password"
             required <%- invalid('password', 'password-hint') %>>
      <p class="hint" id="password-hint">At least 8 characters, with a letter and a number.</p>
      <%- fieldError('password') %>
    </div>
    <div class="form-actions">
      <button class="button button--primary" type="submit" data-busy-text="Creating account…">Create account</button>
    </div>
  </form>

<% } else if (!account.mobileVerified) { %>
  <div class="page-head">
    <h1>Verify your mobile number</h1>
    <p>Enter the 6 digit code sent to <span translate="no"><%= account.mobile %></span>. It works for 10 minutes.</p>
  </div>

  <%- include('partials/error', { error }) %>

  <% if (devCode) { %>
    <p class="note narrow" role="status">Test mode, there is no SMS provider yet. Your code is <span class="code"><%= devCode %></span></p>
  <% } %>

  <form class="panel narrow" method="post" action="/register/verify" novalidate style="margin-top: 1rem">
    <input type="hidden" name="accountId" value="<%= account.id %>">
    <div class="field">
      <label for="code">Verification code</label>
      <input id="code" type="text" name="code" autocomplete="one-time-code" inputmode="numeric"
             maxlength="6" spellcheck="false" required <%= error ? 'aria-invalid="true"' : '' %>>
    </div>
    <div class="form-actions">
      <button class="button button--primary" type="submit" data-busy-text="Checking code…">Verify mobile number</button>
    </div>
  </form>

<% } else { %>
  <div class="page-head">
    <h1>Account verified</h1>
    <p><%= account.name %>, your mobile number <span translate="no"><%= account.mobile %></span> is confirmed. You can book tickets now.</p>
  </div>
  <p><a class="button button--primary" href="/search">Search trains</a></p>
<% } %>

<%- include('partials/bottom') %>

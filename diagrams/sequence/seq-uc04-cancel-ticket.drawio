        </mxCell>
        <mxCell id="p7" value="NotifAdapter" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=0;fontSize=11;size=50;" vertex="1" parent="1">
          <mxGeometry x="1000" y="60" width="90" height="700" as="geometry"/>
        </mxCell>
        <!-- Messages -->
        <mxCell id="m1" value="1. requestCancel(PNR)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1" source="p1" target="p2">

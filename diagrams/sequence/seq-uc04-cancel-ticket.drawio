          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="660"/></mxGeometry>
        </mxCell>
        <!-- Alt fragment -->
        <mxCell id="alt1" value="alt [past cutoff]: refuse with cutoff time" style="shape=umlFrame;whiteSpace=wrap;fontSize=10;strokeColor=#CC0000;fontColor=#CC0000;" vertex="1" parent="1">
          <mxGeometry x="170" y="180" width="240" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

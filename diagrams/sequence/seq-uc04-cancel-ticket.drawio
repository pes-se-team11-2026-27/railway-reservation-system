        <mxCell id="t1" value="&lt;b&gt;Sequence Diagram: UC-04 Cancel a Ticket&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="400" height="30" as="geometry"/>
        </mxCell>
        <!-- Participants -->
        <mxCell id="p1" value="Passenger" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=0;fontSize=11;size=50;participant=umlActor;" vertex="1" parent="1">
